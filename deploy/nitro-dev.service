# nitro dev session on the test box. Runs the freshly deployed
# ~/nitro-bin/nitro-session as the developer user on tty2, inside a
# proper logind session (PAMName) so libseat's logind backend hands the
# compositor the seat without root. `just deploy` rsyncs binaries and
# restarts it.
#
# The unit runs **nitro-session**, not nitro-server: the session starts
# the compositor, waits for its sockets, then starts the wallpaper, the
# bar and the launcher, and supervises all four (M3-E). A shell piece
# that dies is restarted with backoff; the *server* exiting ends the
# session with the server's exit code, which is what systemd reports.
# `systemctl status nitro-dev` therefore shows the whole tree.
#
# Install: just box-install
# Logs:    journalctl -u nitro-dev -f
[Unit]
Description=nitro dev session (tty2)
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty2.service

[Service]
Type=simple
User=kaspar
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
# Make tty2 the foreground VT so logind marks the session active and
# libseat receives `enable` immediately.
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/home/kaspar/nitro-bin/nitro-session
ExecStopPost=+/usr/bin/chvt 1
Environment=RUST_BACKTRACE=1
Environment=NITRO_LOG=info
Restart=no
# 3.3 GB box, no swap: a runaway desktop must die before the box does.
#
# ⚠ THIS LIMIT DOES NOT CURRENTLY BIND ANYTHING, and the reason is two
# lines above it. `PAMName=login` makes pam_systemd move the session —
# and therefore every process in it — into the **logind session scope**,
# `user.slice/user-1000.slice/session-N.scope`. So
# `system.slice/nitro-dev.service/cgroup.procs` is empty while the
# desktop runs, this `MemoryMax` applies to that empty cgroup, and the
# scope the processes are actually in inherits `max` from
# `user-1000.slice`. Verified on the box at M3-E: unit `memory.max` =
# 1073741824, scope `memory.max` = max, with all five processes in the
# scope.
#
# It is kept rather than deleted because it is correct for a session
# started *without* `PAMName` (a `just fake` run under systemd-run, say),
# and because deleting it would leave nothing here to explain the trap.
#
# To make it real, put the limit where the processes are — on the user
# slice, which the scope inherits from:
#
#     sudo systemctl set-property user-1000.slice MemoryMax=1G
#
# (checked on the box: the scope's effective limit becomes 1 G). That is
# a box-wide policy rather than a unit setting, which is why it is a note
# here and not a drop-in: it would also cap the developer's ssh session.
# The M3 desktop measures ~31 MB resident for all five processes — 30 700
# kB re-measured by the #538 audit, of which 13 372 kB is private and the
# rest shared file-backed pages counted once per process (docs/budget.md
# §"The M3 desktop") — so nothing is near the number either way. The guard
# is against a runaway, and the box has needed a power cycle after one
# before (docs/testbox.md).
MemoryMax=1G
# The session's own teardown deadline is 3 s (nitro-session's
# `TEARDOWN_TIMEOUT`), deliberately **inside** this one: the session must
# finish stopping its children and give the VT back before systemd loses
# patience and SIGKILLs it, because a SIGKILLed session leaves the
# compositor holding DRM master with nothing left to release it.
TimeoutStopSec=5
