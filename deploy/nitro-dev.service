# nitro dev server on the test box. Runs the freshly deployed
# ~/nitro-bin/nitro-server as the developer user on tty2, inside a
# proper logind session (PAMName) so libseat's logind backend hands it
# the seat without root. `just deploy` rsyncs binaries and restarts it.
#
# Install: sudo cp deploy/nitro-dev.service /etc/systemd/system/ &&
#          sudo systemctl daemon-reload
# Logs:    journalctl -u nitro-dev -f
[Unit]
Description=nitro dev server (tty2)
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty2.service

[Service]
Type=simple
User=kaspar
PAMName=login
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty2
UtmpMode=user
# Make tty2 the foreground VT so logind marks the session active and
# libseat receives `enable` immediately.
ExecStartPre=+/usr/bin/chvt 2
ExecStart=/home/kaspar/nitro-bin/nitro-server
ExecStopPost=+/usr/bin/chvt 1
Environment=RUST_BACKTRACE=1
Environment=NITRO_LOG=info
Restart=no
# 3.3 GB box, no swap: a runaway server must die before the box does.
MemoryMax=1G
TimeoutStopSec=5
