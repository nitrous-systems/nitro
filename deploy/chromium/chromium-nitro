#!/bin/sh
# Chromium on nitro — the launcher entry's `Exec=` (#3865).
#
# A template: `@CHROMIUM_DIR@` is the browser's directory, substituted at
# install time. `just install-chromium` installs this as
# `$BINDIR/chromium-nitro` with `$LIBDIR/nitro/chromium`. `just
# deploy-chromium` installs it as `~/nitro-bin/chromium-nitro` with a literal
# `$HOME/nitro-bin/chromium`, which this shell expands. A path relative to
# the script was rejected because the two layouts differ (sibling
# `chromium/` on the box, `../lib/nitro/chromium` installed). It exists because
# the launcher spawns without a shell: an `Exec=` line cannot say `~` or
# `$HOME`, and a bare name is house style (see nitro-term.desktop), so the
# flags and the profile path live here instead.
#
# The flags, each necessary:
#   --ozone-platform=nitro  the build's default already (ozone_platform =
#                           "nitro"), spelled out so a stray flag in a
#                           `chrome-flags.conf` cannot silently pick another
#   --disable-gpu --in-process-gpu
#                           software rendering, and the GPU thread in the
#                           browser process: nitro scopes buffer and window
#                           ids per client connection, so an out-of-process
#                           GPU could create buffers but never attach them
#                           to the browser's window (tmp/chromium-backend.md)
#   --class=chromium-nitro  the window's app id, which is what the bar and
#                           the title bar look an icon up by; it must equal
#                           the .desktop file's basename (see that file)
#   --user-data-dir         a dedicated profile, so this build never shares
#                           (or migrates) a profile with any other Chromium
#
# The sandbox is ON: `just deploy-chromium` (or `just install-apparmor`) installs an AppArmor profile
# (deploy/chromium/apparmor-chromium-nitro) granting `userns` to exactly
# this binary, because Ubuntu's `kernel.apparmor_restrict_unprivileged_userns=1`
# denies it to any unconfined program at a custom path.
d="@CHROMIUM_DIR@"
export CHROME_DESKTOP=chromium-nitro.desktop
exec "$d/chrome" \
    --ozone-platform=nitro \
    --disable-gpu \
    --in-process-gpu \
    --class=chromium-nitro \
    --user-data-dir="$HOME/.config/chromium-nitro" \
    "$@"
